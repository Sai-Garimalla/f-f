# TiDB Cloud Connection
DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_USER=your_tidb_username
DB_PASSWORD=your_tidb_password
DB_NAME=fire_and_flavour

# JWT Secret (change this to a strong random string)
JWT_SECRET=your_super_secret_jwt_key_change_this

# Server Port
PORT=3000

# Printer Settings (can also be set via UI)
CUSTOMER_PRINTER_IP=192.168.1.100
CUSTOMER_PRINTER_PORT=9100
KITCHEN_PRINTER_IP=192.168.1.101
KITCHEN_PRINTER_PORT=9100
